---
// Option 2, "Desktop": the page is a Mac desktop. A menu bar on top, sections as windows on
// a wallpaper that follows the active profile, and the demo dock fixed to the bottom of the
// screen, as Dockry would be. Inter, macOS-like rounded windows.
import '@fontsource/inter/latin-400';
import '@fontsource/inter/latin-600';
import '@fontsource/inter/latin-800';
import { Image } from 'astro:assets';
import Base from '../layouts/Base.astro';
import Dock from '../components/Dock.astro';
import icon from '../assets/icon.png';
import work from '../assets/1-work-profile.png';
import side from '../assets/6-left-position.png';
import calendar from '../assets/9-calendar.png';
import { REPO, RELEASES } from '../config';
import { useTranslations } from '../i18n';

const t = useTranslations(Astro.currentLocale);
const [first, middle, last] = t.hero.headline;
---
<Base themeColor="#1b1d3a" colorScheme="dark">
  <div class="wallpaper" aria-hidden="true"></div>

  <header class="menubar">
    <a class="brand" href="#top"><Image src={icon} alt="" width={18} height={18} /> <b>Dockry</b></a>
    <a class="optional" href="#profiles">{t.nav.profiles}</a>
    <a class="optional" href="#dock">{t.nav.dock}</a>
    <a class="optional" href="#widgets">{t.nav.widgets}</a>
    <a href="#install">{t.nav.install}</a>
    <span class="spacer"></span>
    <a href={REPO}>{t.nav.github}</a>
    <span class="clock" data-menu-clock></span>
  </header>

  <main id="top">
    <section class="hero">
      <Image class="app-icon" src={icon} alt="" width={112} height={112} loading="eager" />
      <h1>{first} {middle}<br />{last}</h1>
      <p class="lead">{t.hero.lead}</p>
      <p class="actions">
        <a class="button" href={RELEASES}>{t.hero.download}</a>
        <a class="button secondary" href="#install">{t.hero.install}</a>
      </p>
      <p class="hint">{t.hero.hint} ↓</p>
    </section>

    <section class="window wide" id="profiles">
      <div class="titlebar"><i></i><i></i><i></i><span>{t.profiles.label}</span></div>
      <div class="body split">
        <div>
          <h2>{t.profiles.title}</h2>
          <p class="lead">{t.profiles.lead}</p>
          <ul class="keys">
            {t.profiles.items.map(([key, text]) => (<li><kbd>{key}</kbd><span>{text}</span></li>))}
          </ul>
        </div>
        <Image class="shot" src={work} alt={t.hero.shotAlt} widths={[640, 1100]} sizes="(min-width: 1000px) 560px, 100vw" />
      </div>
    </section>

    <div class="pair">
      <section class="window" id="dock">
        <div class="titlebar"><i></i><i></i><i></i><span>{t.dock.label}</span></div>
        <div class="body">
          <h2>{t.dock.title}</h2>
          <p class="lead">{t.dock.lead}</p>
          <ul class="list">
            {t.dock.items.map(([title, text]) => (<li><b>{title}</b> {text}</li>))}
          </ul>
          <Image class="shot" src={side} alt="Dockry on the left edge of the screen" widths={[640, 1000]} sizes="(min-width: 1000px) 520px, 100vw" />
        </div>
      </section>

      <section class="window" id="widgets">
        <div class="titlebar"><i></i><i></i><i></i><span>{t.widgets.label}</span></div>
        <div class="body">
          <h2>{t.widgets.title}</h2>
          <p class="lead">{t.widgets.lead}</p>
          <ul class="list">
            {t.widgets.items.map(([name, text]) => (<li><b>{name}</b> {text}</li>))}
          </ul>
          <Image class="shot" src={calendar} alt="The month calendar opened from the date widget" widths={[640, 1000]} sizes="(min-width: 1000px) 520px, 100vw" />
        </div>
      </section>
    </div>

    <section class="window narrow" id="install">
      <div class="titlebar"><i></i><i></i><i></i><span>{t.install.label}</span></div>
      <div class="body">
        <h2>{t.install.title}</h2>
        <p class="lead">{t.install.lead}</p>
        <ol class="steps">
          {t.install.steps.map((step) => <li><span set:html={step.replace('{releases}', RELEASES)} /></li>)}
        </ol>
        <p class="note">{t.install.terminal}</p>
        <div class="code"><pre><code>{t.install.command}</code></pre><button type="button" data-copy={t.install.command} data-copied={t.install.copied}>{t.install.copy}</button></div>
      </div>
    </section>

    <footer>
      <p>{t.footer.tagline}</p>
      <p><a href={REPO}>{t.footer.source}</a> · <a href={RELEASES}>{t.footer.releases}</a> · <a href={`${REPO}/issues`}>{t.footer.issues}</a></p>
    </footer>
  </main>

  <div class="dock-bar"><Dock /></div>
</Base>

<script>
  const clock = document.querySelector('[data-menu-clock]')!;
  const tick = () => (clock.textContent = new Date().toLocaleString('en-US', { weekday: 'short', hour: 'numeric', minute: '2-digit' }));
  tick();
  setInterval(tick, 30_000);
</script>

<style is:global>
  :root { --profile: #3563E9; --text: 'Inter', -apple-system, system-ui, sans-serif; }
  body { background: #14152b; color: #fff; font: 400 1rem/1.6 var(--text); }
  a { color: inherit; }
  :focus-visible { outline: 3px solid #fff; outline-offset: 2px; }
</style>

<style>
  .wallpaper {
    position: fixed;
    inset: 0;
    z-index: -1;
    background:
      radial-gradient(60% 50% at 15% 20%, color-mix(in srgb, var(--profile), transparent 25%), transparent 70%),
      radial-gradient(50% 45% at 85% 30%, #b44ad8aa, transparent 70%),
      radial-gradient(70% 60% at 60% 95%, #f08a4b88, transparent 70%),
      #14152b;
    transition: background 500ms;
  }

  .menubar {
    position: sticky;
    top: 0;
    z-index: 10;
    display: flex;
    align-items: center;
    gap: 20px;
    height: 32px;
    padding-inline: 16px;
    background: rgba(20 20 40 / 0.45);
    backdrop-filter: blur(30px) saturate(1.8);
    -webkit-backdrop-filter: blur(30px) saturate(1.8);
    font-size: 0.85rem;
  }
  .menubar a { text-decoration: none; }
  .brand { display: flex; align-items: center; gap: 8px; }
  .spacer { flex: 1; }
  .clock { font-variant-numeric: tabular-nums; white-space: nowrap; }

  main { display: grid; gap: 40px; max-width: 1180px; margin: 0 auto; padding: 0 16px 180px; }

  .hero { display: grid; justify-items: center; text-align: center; gap: 22px; padding: clamp(64px, 12vh, 140px) 0 40px; }
  .app-icon { width: clamp(84px, 10vw, 112px); filter: drop-shadow(0 18px 30px rgba(0 0 0 / 0.4)); }
  h1 { font: 800 clamp(2.6rem, 7vw, 5.6rem)/1 var(--text); letter-spacing: -0.045em; }
  .hero .lead { max-width: 52ch; font-size: 1.15rem; opacity: 0.85; }
  .actions { display: flex; flex-wrap: wrap; justify-content: center; gap: 12px; }
  .button { padding: 13px 22px; border-radius: 999px; background: #fff; color: #111; font-weight: 600; text-decoration: none; }
  .button.secondary { background: rgba(255 255 255 / 0.16); color: #fff; }
  .button:hover { filter: brightness(0.92); }
  .hint { opacity: 0.65; font-size: 0.9rem; }

  .window {
    background: rgba(248 248 252 / 0.94);
    color: #1b1c22;
    border-radius: 14px;
    box-shadow: 0 30px 80px rgba(0 0 0 / 0.45), 0 0 0 0.5px rgba(0 0 0 / 0.3);
    overflow: hidden;
    scroll-margin-top: 60px;
  }
  .narrow { max-width: 760px; width: 100%; justify-self: center; }
  .titlebar { position: relative; display: flex; align-items: center; gap: 8px; height: 40px; padding-inline: 16px; background: rgba(0 0 0 / 0.04); }
  .titlebar i { width: 12px; height: 12px; border-radius: 50%; background: #ff5f57; }
  .titlebar i:nth-child(2) { background: #febc2e; }
  .titlebar i:nth-child(3) { background: #28c840; }
  .titlebar span { position: absolute; inset: 0; display: grid; place-items: center; font-size: 0.82rem; font-weight: 600; opacity: 0.6; pointer-events: none; }
  .body { padding: clamp(24px, 4vw, 48px); display: grid; gap: 18px; align-content: start; }
  .split { grid-template-columns: minmax(0, 1fr) minmax(0, 1.1fr); gap: clamp(24px, 4vw, 56px); align-items: center; }
  h2 { font: 800 clamp(1.8rem, 3.6vw, 2.8rem)/1.05 var(--text); letter-spacing: -0.035em; }
  .body .lead { opacity: 0.7; margin-top: 12px; }
  .shot { border-radius: 8px; box-shadow: 0 12px 30px rgba(0 0 0 / 0.18); }
  .pair { display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); gap: 40px; }

  .keys { display: grid; gap: 12px; margin: 22px 0 0; padding: 0; list-style: none; }
  .keys li { display: grid; grid-template-columns: 7.5em minmax(0, 1fr); gap: 14px; align-items: baseline; }
  kbd { justify-self: start; padding: 3px 8px; border-radius: 6px; background: #fff; box-shadow: 0 1px 0 rgba(0 0 0 / 0.25), 0 0 0 0.5px rgba(0 0 0 / 0.2); font: 600 0.85rem/1.4 var(--text); }
  .list { display: grid; gap: 10px; margin: 6px 0 8px; padding: 0; list-style: none; }
  .list li { padding-left: 18px; position: relative; opacity: 0.85; }
  .list li::before { content: ''; position: absolute; left: 0; top: 0.62em; width: 7px; height: 7px; border-radius: 50%; background: var(--profile); }

  .steps { counter-reset: step; display: grid; gap: 10px; margin: 10px 0 0; padding: 0; list-style: none; }
  .steps li { counter-increment: step; display: grid; grid-template-columns: 28px minmax(0, 1fr); gap: 12px; }
  .steps li::before { content: counter(step); display: grid; place-items: center; width: 26px; height: 26px; border-radius: 50%; background: var(--profile); color: #fff; font-weight: 600; font-size: 0.85rem; }
  .note { opacity: 0.7; }
  .code { position: relative; border-radius: 10px; background: #1b1c22; color: #fff; }
  pre { margin: 0; padding: 16px 92px 16px 18px; overflow-x: auto; font: 0.85rem/1.7 ui-monospace, 'SF Mono', Menlo, monospace; }
  .code button { position: absolute; top: 9px; right: 9px; padding: 7px 12px; border: 0; border-radius: 7px; background: #fff; color: #111; font: 600 0.8rem/1 var(--text); cursor: pointer; }

  footer { text-align: center; opacity: 0.75; display: grid; gap: 6px; padding-top: 20px; }

  .dock-bar { position: fixed; left: 0; right: 0; bottom: 8px; z-index: 10; display: flex; justify-content: center; padding-inline: 8px; pointer-events: none; --dock-bg: rgba(28 28 44 / 0.62); --widget-bg: rgba(255 255 255 / 0.12); }
  .dock-bar :global(.dock) { pointer-events: auto; }

  @media (max-width: 900px) {
    .split, .pair { grid-template-columns: minmax(0, 1fr); }
    .optional { display: none; }
  }
  @media (max-width: 480px) {
    .keys li { grid-template-columns: minmax(0, 1fr); gap: 4px; }
    .menubar { gap: 14px; }
    .clock { display: none; }
  }
</style>
