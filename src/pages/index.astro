---
// Option 4, "Paper": editorial. Warm paper, a big serif, generous whitespace, full-width
// screenshots with captions like a magazine spread. The profile color is the only accent.
// Instrument Serif and Inter.
import '@fontsource/instrument-serif/latin-400';
import '@fontsource/instrument-serif/latin-400-italic';
import '@fontsource/inter/latin-400';
import '@fontsource/inter/latin-600';
import { Image } from 'astro:assets';
import Base from '../layouts/Base.astro';
import Dock from '../components/Dock.astro';
import icon from '../assets/icon.png';
import work from '../assets/1-work-profile.png';
import switcher from '../assets/3-profile-switcher.png';
import spotify from '../assets/10-spotify-player.png';
import { REPO, RELEASES } from '../config';
import { useTranslations } from '../i18n';

const t = useTranslations(Astro.currentLocale);
const [first, middle, last] = t.hero.headline;
---
<Base themeColor="#F5F1E8" colorScheme="light">
  <header class="wrap top">
    <a class="brand" href="#top"><Image src={icon} alt="" width={30} height={30} /> Dockry</a>
    <nav>
      <a class="optional" href="#profiles">{t.nav.profiles}</a>
      <a class="optional" href="#dock">{t.nav.dock}</a>
      <a class="optional" href="#widgets">{t.nav.widgets}</a>
      <a href={RELEASES}>{t.nav.download} →</a>
    </nav>
  </header>

  <main id="top">
    <section class="wrap hero">
      <h1>{first}<br /><em>{middle}</em><br />{last}</h1>
      <div class="intro">
        <p class="lead">{t.hero.lead}</p>
        <p class="actions">
          <a class="button" href={RELEASES}>{t.hero.download}</a>
          <a href="#install">{t.hero.install}</a>
        </p>
      </div>
    </section>

    <figure class="desk">
      <Dock />
      <figcaption class="wrap">{t.hero.hint}.</figcaption>
    </figure>

    <p class="wrap specs">{t.specs.join('  ·  ')}</p>

    <section class="wrap chapter" id="profiles">
      <p class="label">I. {t.profiles.label}</p>
      <h2>{t.profiles.title}</h2>
      <div class="columns">
        <p class="lead drop">{t.profiles.lead}</p>
        <dl>
          {t.profiles.items.map(([key, text]) => (<div><dt>{key}</dt><dd>{text}</dd></div>))}
        </dl>
      </div>
    </section>
    <figure class="bleed">
      <Image src={switcher} alt="The profile switcher over the desktop" widths={[900, 1600, 2400]} sizes="100vw" />
      <figcaption class="wrap">Hold ⌃⌥ and tap Space: the profile switcher.</figcaption>
    </figure>

    <section class="wrap chapter" id="dock">
      <p class="label">II. {t.dock.label}</p>
      <h2>{t.dock.title}</h2>
      <div class="columns">
        <p class="lead drop">{t.dock.lead}</p>
        <dl>
          {t.dock.items.map(([title, text]) => (<div><dt>{title}</dt><dd>{text}</dd></div>))}
        </dl>
      </div>
    </section>
    <figure class="bleed">
      <Image src={work} alt={t.hero.shotAlt} widths={[900, 1600, 2400]} sizes="100vw" />
      <figcaption class="wrap">Work: pinned apps, then open ones, then widgets.</figcaption>
    </figure>

    <section class="wrap chapter" id="widgets">
      <p class="label">III. {t.widgets.label}</p>
      <h2>{t.widgets.title}</h2>
      <div class="columns">
        <p class="lead drop">{t.widgets.lead}</p>
        <dl>
          {t.widgets.items.map(([name, text]) => (<div><dt>{name}</dt><dd>{text}</dd></div>))}
        </dl>
      </div>
    </section>
    <figure class="bleed">
      <Image src={spotify} alt="The Spotify player opened from the dock, with search results" widths={[900, 1600, 2400]} sizes="100vw" />
      <figcaption class="wrap">Chill: the Spotify player and search, without leaving what you’re doing.</figcaption>
    </figure>

    <section class="wrap chapter" id="install">
      <p class="label">IV. {t.install.label}</p>
      <h2>{t.install.title}</h2>
      <div class="columns">
        <p class="lead drop">{t.install.lead}</p>
        <div>
          <ol class="steps">
            {t.install.steps.map((step) => <li><span set:html={step.replace('{releases}', RELEASES)} /></li>)}
          </ol>
          <p class="note">{t.install.terminal}</p>
          <div class="code"><pre><code>{t.install.command}</code></pre><button type="button" data-copy={t.install.command} data-copied={t.install.copied}>{t.install.copy}</button></div>
        </div>
      </div>
    </section>
  </main>

  <footer class="wrap">
    <p class="sign">Dockry</p>
    <p>{t.footer.tagline}</p>
    <p class="links"><a href={REPO}>{t.footer.source}</a><a href={RELEASES}>{t.footer.releases}</a><a href={`${REPO}/issues`}>{t.footer.issues}</a></p>
  </footer>
</Base>

<style is:global>
  :root {
    --profile: #3563E9;
    --paper: #F5F1E8;
    --ink: #1a1814;
    --serif: 'Instrument Serif', 'Iowan Old Style', Georgia, serif;
    --sans: 'Inter', system-ui, sans-serif;
  }
  body { background: var(--paper); color: var(--ink); font: 400 1.02rem/1.65 var(--sans); }
  a { color: inherit; text-underline-offset: 4px; text-decoration-thickness: 1px; }
  a:hover { color: var(--profile); }
  :focus-visible { outline: 2px solid var(--profile); outline-offset: 3px; }
</style>

<style>
  .wrap { max-width: 1160px; margin: 0 auto; padding-inline: max(16px, 5vw); }
  @media (min-width: 1300px) { .wrap { padding-inline: 0; } }

  .top { display: flex; align-items: center; justify-content: space-between; gap: 16px; padding-block: 26px; }
  .brand { display: flex; align-items: center; gap: 10px; font: 400 1.7rem/1 var(--serif); text-decoration: none; }
  nav { display: flex; gap: 28px; font-size: 0.92rem; }
  nav a { text-decoration: none; }

  .hero { padding-block: clamp(56px, 10vw, 130px) clamp(40px, 6vw, 72px); }
  h1 { font: 400 clamp(3.4rem, 10.5vw, 9.4rem)/0.88 var(--serif); letter-spacing: -0.025em; }
  h1 em { color: var(--profile); transition: color 400ms; }
  .intro { display: grid; grid-template-columns: minmax(0, 1fr) auto; gap: 40px; align-items: end; margin-top: 48px; padding-top: 28px; border-top: 1px solid var(--ink); }
  .lead { font-size: 1.2rem; max-width: 44ch; }
  .actions { display: flex; align-items: center; gap: 22px; white-space: nowrap; }
  .button { display: inline-block; padding: 15px 24px; background: var(--ink); color: var(--paper); text-decoration: none; font-weight: 600; }
  .button:hover { background: var(--profile); color: #fff; }

  .desk {
    margin: 0;
    padding: clamp(80px, 12vw, 150px) 16px 28px;
    display: grid;
    justify-items: center;
    gap: 20px;
    background: linear-gradient(170deg, color-mix(in srgb, var(--profile), white 20%), color-mix(in srgb, var(--profile), black 35%));
    transition: background 500ms;
    --dock-bg: rgba(255 255 255 / 0.2);
  }
  .desk figcaption { color: #fff; font: italic 400 1.15rem/1.3 var(--serif); text-align: center; }
  .specs { padding-block: 22px; text-align: center; font-size: 0.85rem; letter-spacing: 0.04em; border-bottom: 1px solid rgba(0 0 0 / 0.15); white-space: pre-wrap; }

  .chapter { padding-block: clamp(80px, 11vw, 150px) clamp(48px, 6vw, 80px); scroll-margin-top: 10px; }
  .label { font: italic 400 1.3rem/1 var(--serif); color: var(--profile); margin-bottom: 18px; transition: color 400ms; }
  h2 { font: 400 clamp(2.6rem, 6.4vw, 5.4rem)/0.98 var(--serif); letter-spacing: -0.02em; max-width: 16ch; }
  .columns { display: grid; grid-template-columns: minmax(0, 1fr) minmax(0, 1.15fr); gap: clamp(32px, 6vw, 96px); margin-top: 48px; }
  .drop::first-letter { float: left; font: 400 4.4em/0.8 var(--serif); margin: 0.06em 0.08em 0 0; color: var(--profile); }
  dl { margin: 0; display: grid; }
  dl div { padding: 16px 0; border-top: 1px solid rgba(0 0 0 / 0.18); }
  dt { font: 400 1.45rem/1.2 var(--serif); }
  dd { margin: 4px 0 0; opacity: 0.72; }

  .bleed { margin: 0; }
  .bleed :global(img) { width: 100%; }
  .bleed figcaption { padding-block: 14px; font: italic 400 1.05rem/1.4 var(--serif); opacity: 0.8; }

  .steps { counter-reset: step; margin: 0 0 24px; padding: 0; list-style: none; display: grid; }
  .steps li { counter-increment: step; display: grid; grid-template-columns: 2.2em minmax(0, 1fr); padding: 14px 0; border-top: 1px solid rgba(0 0 0 / 0.18); }
  .steps li::before { content: counter(step) '.'; font: 400 1.4rem/1.1 var(--serif); color: var(--profile); }
  .note { opacity: 0.72; margin-bottom: 10px; }
  .code { position: relative; background: var(--ink); color: var(--paper); }
  pre { margin: 0; padding: 18px 96px 18px 18px; overflow-x: auto; font: 0.85rem/1.7 ui-monospace, 'SF Mono', Menlo, monospace; }
  .code button { position: absolute; top: 10px; right: 10px; padding: 7px 12px; border: 0; background: var(--paper); color: var(--ink); font: 600 0.78rem/1 var(--sans); cursor: pointer; }

  footer { padding-block: 100px 60px; display: grid; gap: 6px; border-top: 1px solid var(--ink); margin-top: 60px; }
  .sign { font: 400 clamp(4rem, 14vw, 10rem)/0.9 var(--serif); letter-spacing: -0.03em; }
  .links { display: flex; gap: 24px; margin-top: 12px; }

  @media (max-width: 860px) {
    .intro, .columns { grid-template-columns: minmax(0, 1fr); }
    .actions { white-space: normal; flex-wrap: wrap; }
    .optional { display: none; }
  }
</style>
