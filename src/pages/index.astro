---
// A placeholder until a design is merged: each design's pull request replaces this page.
import Base from '../layouts/Base.astro';
import Dock from '../components/Dock.astro';
import { useTranslations } from '../i18n';

const t = useTranslations(Astro.currentLocale);
---
<Base themeColor="#3563E9" colorScheme="dark">
  <main>
    <h1>Dockry</h1>
    <p>{t.description}</p>
    <Dock />
  </main>
</Base>

<style>
  main { min-height: 100vh; display: grid; place-content: center; justify-items: center; gap: 24px; padding: 16px; text-align: center; background: var(--profile, #3563E9); color: #fff; font: 400 1rem/1.6 system-ui, sans-serif; }
  h1 { font-size: 3rem; }
  p { max-width: 52ch; }
</style>
